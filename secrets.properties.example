# Optional publisher Geoapify key. Personal testers can leave this blank and enter a key
# inside the installed app: Settings -> Routing access. No rebuild is required for that.
# A compiled shared key is extractable from the APK; review provider plan and access
# protection before public distribution. Never commit a real key or share it in logs.
GEOAPIFY_API_KEY=
# Publisher HTTPS pages for the public release (not required for personal key entry).
PUBLIC_PRIVACY_URL=https://YOUR-DOMAIN/privacy
PUBLIC_TERMS_URL=https://YOUR-DOMAIN/terms
PUBLIC_SOURCE_URL=https://YOUR-PUBLIC-SOURCE
